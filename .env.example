# DB
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=dbtable
DB_HOST=localhost
DB_PORT=5432

# SERVICE TO SERVICER KEY
INTERNAL_API_SECRET=testtest

# Time Zone Docker
TZ=Asia/Bangkok

# API APP
JWT_SECRET=JWT_SECRET
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=password
SERVER_API_PORT=8080
LOG_API_DIR=./local_logs/api # local is ./... in prod use /app/logs
LOG_API_MAX_SIZE=10
LOG_API_MAX_BACKUP=5
LOG_API_MAX_AGE=28
log_api_level=info

# SCHEDULE ENGINE APP
SCHEDULE_ENGINE_URL=http://localhost:8081
SERVER_SCHEDULE_ENGINE_PORT=8081
LOG_SCHEDULE_ENGINE_DIR=./local_logs/schedule # local is ./... in prod use /app/logs
LOG_SCHEDULE_ENGINE_MAX_SIZE=10
LOG_SCHEDULE_ENGINE_MAX_BACKUP=5
LOG_SCHEDULE_ENGINE_MAX_AGE=28
LOG_SCHEDULE_ENGINE_LEVEL=info

# DEVICE GATEWAY APP
DEVICE_GATEWAY_URL=http://localhost:8091
DEVICE_GATEWAY_PORT=8090
DEVICE_GATEWAY_HTTP_PORT=8091
MQTT_BROKER_URL=tcp://localhost:1883
DEVICE_GATEWAY_QUEUE_BUFFER=300
DEVICE_GATEWAY_QUEUE_TIMEOUT_SECOND=3
LOG_DEVICE_GATEWAY_DIR=/app/logs # local is ./... in prod use /app/logs
LOG_DEVICE_GATEWAY_MAX_SIZE=10
LOG_DEVICE_GATEWAY_MAX_BACKUP=5
LOG_DEVICE_GATEWAY_MAX_AGE=20
LOG_DEVICE_GATEWAY_LEVEL=info