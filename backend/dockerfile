# Stage 1: Build the Go binary
FROM golang:1.26-alpine3.24 AS builder
WORKDIR /app

# 1. Copy dependencies first for caching
COPY go.mod go.sum ./ 
RUN go mod download

# Copy the rest of the source code
COPY . .

# 2. Build with CGO disabled and ldflags for optimization
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o iot-monitor-interface-api ./cmd/server/main.go

# Stage 2: Create the minimal production image
FROM alpine:3.24
WORKDIR /app

# 3. Add CA certificates (Highly recommended for APIs)
RUN apk --no-cache add ca-certificates

# 4. Create and switch to a non-root user
RUN adduser -D nonrootuser
USER nonrootuser

# Copy the binary from the builder stage
COPY --from=builder /app/iot-monitor-interface-api .

EXPOSE 8080
CMD ["./iot-monitor-interface-api"]